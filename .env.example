HOST=127.0.0.1
PORT=8807
DATA_DIR=./data

# "Sign in with Ward" (optional): Ward's local seed.mjs fills these five. With
# WARD_OIDC_ISSUER unset the server runs with local accounts only. The key is a
# secret: never commit a value.
WARD_OIDC_ISSUER=
WARD_OIDC_CLIENT_ID=
WARD_OIDC_CLIENT_KEY=
WARD_OIDC_REDIRECT_URI=
WARD_OIDC_POST_LOGOUT_REDIRECT_URI=

# The app's own origin as the browser sees it, e.g. https://example.com. Optional
# when WARD_OIDC_REDIRECT_URI is set (its origin is used); required otherwise.
PUBLIC_ORIGIN=
# The API prefix and the web base as the browser sees them. These are the defaults.
# SATCHEL_API_PREFIX=/satchel-api
# SATCHEL_BASE=/satchel/

# Web Push (optional). Without all three the server runs with push off.
# Make a pair once with `npx web-push generate-vapid-keys`; see the README.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:johndoe@example.com
