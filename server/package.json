{
  "name": "@satchel/server",
  "version": "0.1.0",
  "description": "The Satchel API (Fastify + SQLite).",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.1",
    "@satchel/shared": "0.1.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "jose": "6.2.10",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "tsx": "4.23.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/ward/testing/testApp.d.ts",
      "default": "./dist/ward/testing/testApp.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    }
  }
}
