{
  "name": "@satchel/server",
  "version": "0.1.0",
  "description": "The Satchel API (Fastify + SQLite).",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.1",
    "@satchel/shared": "0.1.0",
    "better-sqlite3": "13.0.3",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "web-push": "3.6.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/web-push": "3.6.4",
    "tsx": "4.23.13"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./testing": {
      "types": "./dist/testing/testApp.d.ts",
      "default": "./dist/testing/testApp.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./store": {
      "types": "./dist/db/store.d.ts",
      "default": "./dist/db/store.js"
    }
  }
}
