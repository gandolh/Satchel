{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "../node_modules/.tmp/web.tsbuildinfo"
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts"]
}
