{
  "name": "satchel",
  "version": "0.1.0",
  "description": "A small messenger for the owner and friends, with an Ideas inbox Claude can write to.",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web",
    "cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsc -b shared && concurrently --names server,web --kill-others-on-fail \"npm run dev -w @satchel/server\" \"npm run dev -w @satchel/web\"",
    "build": "tsc -b && npm run build -w @satchel/web",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p web --noEmit",
    "lint": "eslint .",
    "house-style:sync": "node vendor/house-style/bin/sync.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@vitest/eslint-plugin": "1.6.28",
    "concurrently": "10.0.5",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.9.1",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "overrides": {
    "shell-quote": "1.11.0",
    "zod": "4.5.4"
  }
}
